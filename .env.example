# Copy this file to .env and fill in real values.  NEVER commit .env.
#   cp .env.example .env

# --- Django core ---
DJANGO_DEBUG=True
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- Database: "sqlite" for learning, "postgres" for production-like setups ---
DB_ENGINE=sqlite
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- API ---
API_PAGE_SIZE=20

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Optional: separate key for signing tokens (defaults to DJANGO_SECRET_KEY).
# Rotating it logs every user out immediately.
JWT_SIGNING_KEY=

# --- Rate limits (format: number/second|minute|hour|day) ---
THROTTLE_ANON_RATE=100/hour
THROTTLE_USER_RATE=2000/hour
THROTTLE_AUTH_RATE=10/minute

# --- CORS / CSRF (comma-separated, leave empty until a frontend exists) ---
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
